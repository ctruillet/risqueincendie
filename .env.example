# Copier ce fichier en .env et le compléter (il n'est jamais commité).

# Adresse publique du site (sert aux liens dans les mails)
PUBLIC_URL=https://massifs.example.fr

# Port du site : dans le conteneur et sur la machine (127.0.0.1:<PORT>, derrière le reverse proxy)
PORT=3000

# --- Connexion avec les identifiants Intranet SGDF ---
# Valeurs fournies par le SI SGDF (client Keycloak autorisé à vérifier les identifiants).
INTRANET_URL=https://auth.sgdf-qual.intrassoc.com/auth
INTRANET_REALM=sgdf_qualification
INTRANET_CLIENT_ID=
INTRANET_CLIENT_SECRET=

# Responsables du site : identifiants Intranet (numéros d'adhérent) ou e-mails, séparés par des virgules.
# Ils créent les camps et en nomment les admins.
SUPER_ADMINS=

# --- Envoi des mails : Proton Mail ---
# Créer un SMTP token : Proton Mail > Paramètres > IMAP/SMTP > SMTP tokens.
# Le token est lié à une adresse de domaine personnalisé : la mettre dans SMTP_USER et MAIL_FROM.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=notifications@example.fr
SMTP_PASS=
MAIL_FROM="Prévisions des Massifs <notifications@example.fr>"

# --- Réglages facultatifs (valeurs par défaut) ---
# Saison de relevé de l'historique (MM-JJ:MM-JJ). Les dates des camps s'y ajoutent.
# SEASON=06-01:09-30
# Heure de Paris à partir de laquelle les prévisions du lendemain sont relevées
# START_HOUR=17
# Fréquence des relevés, en minutes
# UPDATE_INTERVAL_MINUTES=15
# Si tout n'est pas publié à cette heure, le mail part avec ce qui est disponible
# NOTIFY_DEADLINE_HOUR=21
